<Window x:Class="BlueDrop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="620" Width="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#202020">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3D3D3D" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3D3D3D" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <CheckBox x:Name="PopupCheckBox" Content="Show popup" Click="OnOptionClick" />
            <CheckBox x:Name="HideContentCheckBox" Content="Hide content in popup" Click="OnOptionClick" />
            <DockPanel Margin="0,0,0,12">
                <TextBox x:Name="DurationBox" DockPanel.Dock="Right" Width="80" LostKeyboardFocus="OnDurationCommit" KeyDown="OnFieldKeyDown" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Popup duration (seconds)" />
            </DockPanel>
            <CheckBox x:Name="AutoCopyCheckBox" Content="Copy automatically" Click="OnOptionClick" />
            <CheckBox x:Name="SoundCheckBox" Content="Sound on receive" Click="OnOptionClick" />
            <CheckBox x:Name="ClearAfterFetchCheckBox" Content="Clear after fetching" Click="OnOptionClick"
                      ToolTip="Removes the pasted item from this app once the phone has fetched it. The Windows clipboard is not changed." />
            <DockPanel Margin="0,0,0,12">
                <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Width="140" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Paste hotkey" />
            </DockPanel>
            <CheckBox x:Name="AutoStartCheckBox" Content="Start with Windows" Click="OnAutoStartClick" />
            <DockPanel>
                <TextBox x:Name="PortBox" DockPanel.Dock="Right" Width="80" LostKeyboardFocus="OnPortCommit" KeyDown="OnFieldKeyDown" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
            </DockPanel>
            <TextBlock Text="Paired devices" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,24,0,8" />
            <Button Style="{StaticResource TileButton}" Height="36" Padding="0" Click="OnPairClick">
                <TextBlock x:Name="PairLabel" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <ItemsControl x:Name="DeviceList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2B2B2B" Padding="10,8" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Width="20" Height="20" Margin="8,0,0,0"
                                        VerticalAlignment="Top" Tag="{Binding}" Click="OnRemoveClick" />
                                <StackPanel>
                                    <TextBox Text="{Binding Name, Mode=OneTime}" Background="#202020" Tag="{Binding}"
                                             LostKeyboardFocus="OnNameCommit" KeyDown="OnFieldKeyDown" />
                                    <TextBlock Text="{Binding Details}" Foreground="#A0A0A0" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
