<Window x:Class="ClipboardPhonePc.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug"
        Height="720" Width="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#202020">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3D3D3D" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="ButtonLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,0,16,16">
            <TextBlock Style="{StaticResource Heading}" Text="Tray icon" />
            <UniformGrid Columns="5">
                <Button Style="{StaticResource TileButton}" Padding="0,8" Margin="0,0,4,0" Tag="Normal" Click="OnIconClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Normal" />
                </Button>
                <Button Style="{StaticResource TileButton}" Padding="0,8" Margin="0,0,4,0" Tag="Pending" Click="OnIconClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Pending" />
                </Button>
                <Button Style="{StaticResource TileButton}" Padding="0,8" Margin="0,0,4,0" Tag="Problem" Click="OnIconClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Problem" />
                </Button>
                <Button Style="{StaticResource TileButton}" Padding="0,8" Margin="0,0,4,0" Tag="Both" Click="OnIconClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Both" />
                </Button>
                <Button Style="{StaticResource TileButton}" Padding="0,8" Click="OnIconResetClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Reset" />
                </Button>
            </UniformGrid>

            <TextBlock Style="{StaticResource Heading}" Text="Tray messages" />
            <WrapPanel x:Name="MessagePanel" Margin="0,0,-4,0" />
            <TextBox x:Name="CustomMessageBox" Text="Custom message" Margin="0,4,0,8" />
            <UniformGrid Columns="2">
                <Button Style="{StaticResource TileButton}" Padding="0,8" Margin="0,0,4,0" Click="OnMessageAddClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Add custom" />
                </Button>
                <Button Style="{StaticResource TileButton}" Padding="0,8" Click="OnMessageClearClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Remove all" />
                </Button>
            </UniformGrid>

            <TextBlock Style="{StaticResource Heading}" Text="Popup" />
            <TextBox x:Name="PopupBox" Text="Test popup" />
            <Button Style="{StaticResource TileButton}" Padding="0,8" Click="OnPopupClick">
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Show popup" />
            </Button>

            <TextBlock Style="{StaticResource Heading}" Text="Pairing" />
            <TextBox x:Name="DeviceNameBox" Text="Debug device" />
            <Button Style="{StaticResource TileButton}" Padding="0,8" Margin="0,0,0,8" Click="OnPairClick">
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Create pair" />
            </Button>
            <TextBox x:Name="KeyBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource Heading}" Text="Transfer" />
            <TextBox x:Name="TransferBox" Text="Test text" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
            <UniformGrid Columns="2">
                <Button Style="{StaticResource TileButton}" Padding="0,8" Margin="0,0,4,0" Click="OnSendClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Send to PC" />
                </Button>
                <Button Style="{StaticResource TileButton}" Padding="0,8" Click="OnGetClick">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Get from PC" />
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Window>
